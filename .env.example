APP_NAME="Rehab Health Events Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Photo gallery (config/gallery.php). Photos are stored on this disk; uploads
# arrive in chunks of GALLERY_CHUNK_KB, which must stay under nginx's request limit.
GALLERY_DISK=local
GALLERY_CHUNK_KB=900
GALLERY_MAX_PHOTO_MB=50
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@rehabhealth.or.tz"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# Payment accounts. SAMPLE VALUES FOR THE DEMO ONLY: replace them with the real
# accounts before going live. An account without a number is hidden.
PAYMENT_REFERENCE_PREFIX=RH
PAYMENT_BANK_TZS_BANK_NAME="CRDB Bank PLC"
PAYMENT_BANK_TZS_ACCOUNT_NAME="Rehab Health"
PAYMENT_BANK_TZS_ACCOUNT_NUMBER="0150 000 000 00 (sample)"
PAYMENT_BANK_TZS_BRANCH="Azikiwe Branch"
PAYMENT_BANK_TZS_SWIFT=CORUTZTZ
PAYMENT_BANK_USD_BANK_NAME="CRDB Bank PLC"
PAYMENT_BANK_USD_ACCOUNT_NAME="Rehab Health"
PAYMENT_BANK_USD_ACCOUNT_NUMBER="0250 000 000 00 (sample)"
PAYMENT_BANK_USD_BRANCH="Azikiwe Branch"
PAYMENT_BANK_USD_SWIFT=CORUTZTZ
PAYMENT_MPESA_PAY_NUMBER="000000 (sample)"
PAYMENT_MPESA_ACCOUNT_NAME="Rehab Health"
PAYMENT_AIRTEL_PAY_NUMBER="000000 (sample)"
PAYMENT_AIRTEL_ACCOUNT_NAME="Rehab Health"
PAYMENT_MIXX_PAY_NUMBER="000000 (sample)"
PAYMENT_MIXX_ACCOUNT_NAME="Rehab Health"
PAYMENT_HALOPESA_PAY_NUMBER="000000 (sample)"
PAYMENT_HALOPESA_ACCOUNT_NAME="Rehab Health"

# First administrator, created by: php artisan db:seed --class=DeploymentSeeder
ADMIN_EMAIL=
ADMIN_PASSWORD=
