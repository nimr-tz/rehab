APP_NAME="Rehab Summit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
CRITICAL_ERROR_ALERTS_ENABLED=false
CRITICAL_ERROR_ALERT_MAILER="${MAIL_MAILER}"
CRITICAL_ERROR_ALERT_RECIPIENTS=
CRITICAL_ERROR_ALERT_DEDUPE_MINUTES=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payments (config/payments.php) — bank transfer and mobile money, verified by finance
PAYMENT_REFERENCE_PREFIX=RH
FEE_PROFESSIONAL_LOCAL=0
FEE_PROFESSIONAL_INTERNATIONAL=0
FEE_STUDENT_LOCAL=0
FEE_STUDENT_INTERNATIONAL=0
PAYMENT_BANK_TRANSFER_ENABLED=true
PAYMENT_BANK_TZS_BANK_NAME=
PAYMENT_BANK_TZS_ACCOUNT_NAME=
PAYMENT_BANK_TZS_ACCOUNT_NUMBER=
PAYMENT_BANK_TZS_BRANCH=
PAYMENT_BANK_TZS_SWIFT=
PAYMENT_BANK_USD_BANK_NAME=
PAYMENT_BANK_USD_ACCOUNT_NAME=
PAYMENT_BANK_USD_ACCOUNT_NUMBER=
PAYMENT_BANK_USD_BRANCH=
PAYMENT_BANK_USD_SWIFT=
PAYMENT_MOBILE_MONEY_ENABLED=true
PAYMENT_MPESA_PAY_NUMBER=
PAYMENT_MPESA_ACCOUNT_NAME=
PAYMENT_AIRTEL_PAY_NUMBER=
PAYMENT_AIRTEL_ACCOUNT_NAME=
PAYMENT_MIXX_PAY_NUMBER=
PAYMENT_MIXX_ACCOUNT_NAME=
PAYMENT_HALOPESA_PAY_NUMBER=
PAYMENT_HALOPESA_ACCOUNT_NAME=
PAYMENT_MOBILE_MONEY_GATEWAY=

# First administrator (database/seeders/DeploymentSeeder.php)
ADMIN_EMAIL=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_PASSWORD=

# Conference edition (config/conference.php) — defaults are the 2026 Rehab Summit
